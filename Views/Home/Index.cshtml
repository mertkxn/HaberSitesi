@model SonGun.Models.ViewModels.HomeIndexViewModel

@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="text-center mb-4" data-aos="zoom-in">
    <h1 class="display-4 fw-bold theme-heading">SON GÜN</h1>
    <p class="lead text-muted-custom">Tarihin en kritik dönüm noktaları, gizemli ölümler ve son anlar...</p>
    <hr class="w-50 mx-auto theme-divider" />
</div>

<!-- Kategori Filtreleme Butonları -->
@if (Model.Categories != null && Model.Categories.Any())
{
    <div class="d-flex flex-wrap justify-content-center gap-2 mb-5" data-aos="fade-up">
        <a asp-action="Index" 
           class="btn btn-sm rounded-pill px-3 py-2 @(Model.SelectedCategoryId == null ? "btn-light text-dark fw-bold" : "btn-outline-secondary")">
            <i class="fas fa-layer-group me-1"></i> Tümü
        </a>
        @foreach (var cat in Model.Categories)
        {
            var isSelected = Model.SelectedCategoryId == cat.Id;
            <a asp-action="Index" asp-route-categoryId="@cat.Id" 
               class="btn btn-sm rounded-pill px-3 py-2 @(isSelected ? "btn-danger fw-bold" : "btn-outline-secondary")"
               title="@cat.Description">
                <i class="fas fa-tag me-1"></i> @cat.Name
            </a>
        }
    </div>
}

@if (!string.IsNullOrEmpty(Model.SelectedCategoryName))
{
    <div class="alert alert-dark border-secondary d-flex justify-content-between align-items-center mb-4" data-aos="fade-in">
        <span><i class="fas fa-filter text-danger me-2"></i><strong>@Model.SelectedCategoryName</strong> kategorisindeki haberler gösteriliyor.</span>
        <a asp-action="Index" class="btn btn-sm btn-outline-light">Filtreyi Temizle</a>
    </div>
}

<div class="row">
    @if(Model.NewsList != null && Model.NewsList.Any())
    {
        int delay = 0;
        foreach(var news in Model.NewsList)
        {
            <div class="col-md-6 col-lg-4 mb-4" data-aos="fade-up" data-aos-delay="@delay">
                <div class="card card-theme h-100 shadow-sm rounded-3 overflow-hidden d-flex flex-column">
                    @if (!string.IsNullOrEmpty(news.ImageUrl))
                    {
                        <div class="position-relative overflow-hidden" style="height: 310px; background-color: #161616;">
                            <img src="@news.ImageUrl" 
                                 class="card-img-top w-100 h-100" 
                                 alt="@news.Title" 
                                 style="object-fit: cover; object-position: top center; transition: transform 0.3s ease;" 
                                 onmouseover="this.style.transform='scale(1.04)'" 
                                 onmouseout="this.style.transform='scale(1)'" 
                                 onerror="this.src='/images/logo.png'">
                        </div>
                    }
                    else
                    {
                        <div class="card-img-top bg-secondary d-flex justify-content-center align-items-center" style="height: 310px;">
                            <i class="fas fa-skull-crossbones fa-4x text-light opacity-75"></i>
                        </div>
                    }
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-danger rounded-pill px-2 py-1">
                                <i class="fas fa-tag me-1"></i>@(news.Category?.Name ?? "Genel")
                            </span>
                            <span class="badge bg-dark border border-secondary rounded-pill px-2 py-1 text-light">
                                <i class="fas fa-skull me-1 text-danger"></i>@news.Author
                            </span>
                        </div>
                        <h5 class="card-title fw-bold theme-heading mt-2">@news.Title</h5>
                        <p class="card-text text-muted-custom mt-2 flex-grow-1">
                            @(news.Content.Length > 120 ? news.Content.Substring(0, 120) + "..." : news.Content)
                        </p>
                    </div>
                    <div class="card-footer card-footer-theme border-0 text-center pb-3">
                        <a asp-action="Details" asp-route-id="@news.Id" class="btn btn-theme-outline w-100 py-2">
                            Devamını Oku <i class="fas fa-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
            delay += 50;
        }

        @if(Model.TotalPages > 1)
        {
            <div class="col-12 mt-4" data-aos="fade-up">
                <nav aria-label="Haber sayfaları">
                    <ul class="pagination pagination-theme justify-content-center">
                        <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" 
                               asp-route-page="@(Model.CurrentPage - 1)" 
                               asp-route-categoryId="@Model.SelectedCategoryId">Önceki</a>
                        </li>
                        @for(int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index" 
                                   asp-route-page="@i" 
                                   asp-route-categoryId="@Model.SelectedCategoryId">@i</a>
                            </li>
                        }
                        <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" 
                               asp-route-page="@(Model.CurrentPage + 1)" 
                               asp-route-categoryId="@Model.SelectedCategoryId">Sonraki</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center text-muted-custom my-5" data-aos="fade-in">
            <i class="fas fa-newspaper fa-3x mb-3 opacity-50"></i>
            <h5 class="fw-light">Bu kategoride henüz gösterilecek bir haber bulunmuyor.</h5>
        </div>
    }
</div>
